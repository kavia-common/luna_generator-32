function TcpIpScan()
    print("Client started.");
    DELAY (0.5)
    while true do
    	dataScan=ReadModbus({modbus_scanner_trigger},"W")
        if dataScan==1 then
            WriteModbus({modbus_scanner_trigger},"W",0)
            ABC = "01_S"
            RBSocket01:Send(ABC)
            print("senddata1: 01_S")
            break            
        end 
    end	    
    while true do
        RBrets = RBSocket01:Receive()          
        if RBrets ~= nil then
            CMD=RBrets[1]   
            print("CMD: ", CMD)
            --ret = split (CMD,",")                  
            sn1 = CMD
            print("1 = ",sn1)
            --end
            RBrets = nil
            break            
        end
        
    end 
end

