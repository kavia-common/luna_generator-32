end 

function SpeedHigh()
	SpdJ (40)
	AccJ (50)
	DecJ (50)
	SpdL (1000)
	AccL (12000)
	DecL (12000)
	Accur ("ROUGH")
end 

function Speed(percent)
    SpdJ(percent)
    AccJ(percent-10)
    DecJ(percent-10)
    SpdL(percent*20)
    AccL(percent*250)
    DecL(percent*250)
    Accur ("ROUGH")
    --print("SpdJ="..percent..+"AccJ=")--..(percent-10)..+"DecJ="..(percent-10))
end

