function Timer66()
	tt = tt + 1
	DELAY(0.5)
	--print(tt)
	if tt < 3 then
		DO("TowerLightG","ON")
		DO("TowerLightY","OFF")
		DO("TowerLightR","OFF")
	end
	if tt > 120 then
		DO("TowerLightG","OFF")
		DO("TowerLightY","OFF")
		DO("TowerLightR","OFF")
	end
end

